{
  "name": "primata-web-quickplay",
  "version": "1.0.0",
  "private": true,
  "description": "Automated browser tests for Primata Web Quickplay.",
  "scripts": {
    "serve": "node tools/serve-static.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/collection-smoke.spec.js",
    "test:e2e:headed": "playwright test --headed --project=desktop-chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:snowball": "playwright test tests/snowball-avalanche.spec.js --project=desktop-chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
